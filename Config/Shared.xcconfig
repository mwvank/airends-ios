// App identity in one place, so renaming the app is a one-line change.
// "Airends" is a working title; the code and module use the neutral name ErrandPlanner.
APP_DISPLAY_NAME = Airends

// Replace with your own reverse-domain ID before the first TestFlight build.
// It cannot change after the app is on the App Store.
APP_BUNDLE_ID = com.mwvank.errandplanner

// Set to your Apple Developer Team ID to sign on a real device.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// The backend that calls Google on the app's behalf, without "https://"
// (xcconfig treats "//" as a comment). Example: us-central1-airends.cloudfunctions.net/api
// Leave empty to use MapKit search and estimated drive times.
BACKEND_HOST =
